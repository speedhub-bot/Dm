# Copy to backend/.env and edit. All values are optional — defaults work for local dev.

DEBUG=true
DEMO_MODE=true

# Strong, random key — generate with `python -c "import secrets; print(secrets.token_urlsafe(48))"`
SECRET_KEY=change-me-please-use-a-strong-random-key-in-production-32+chars

# Generate with `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`
FERNET_KEY=zmF8e7K0d5g2y3n4q5r6t7u8v9w0x1y2z3A4B5C6D7E=

# Database
DATABASE_URL=sqlite:///./dm.db

# First-run admin (used only if no users exist yet)
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=changeme123

# Throttling defaults
DEFAULT_MIN_DELAY_SEC=45
DEFAULT_MAX_DELAY_SEC=120
DEFAULT_DAILY_CAP=50
DEFAULT_HOURLY_CAP=12

# Scheduler
SCHEDULER_INTERVAL_SEC=15
